{$SITE_ADDRESS:localhost}

log {
    output stdout
    format console
    level INFO
}

encode gzip zstd

root * /usr/share/caddy

file_server

header {
    # Cache headers - 1 hour for all files
    Cache-Control "public, max-age=3600"
    
    # Remove server header for security
    -Server
}

# Try to serve files, fallback to index.html for SPA-like behavior
try_files {path} {path}/ /index.html
